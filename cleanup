#!/usr/bin/env bash
# cleanup <openrc> <tag> <ssh_key>
#
# Stage 3 of the NSO project lifecycle: release every cloud resource we
# created for <tag>. Tag-driven, so it works even with no local state file.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# macOS Ansible workaround for High Sierra+ fork() restrictions.
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY="${OBJC_DISABLE_INITIALIZE_FORK_SAFETY:-YES}"
if [[ -d "$HERE/venv" ]]; then
    # shellcheck disable=SC1091
    source "$HERE/venv/bin/activate"
fi
exec python3 "$HERE/cleanup.py" "$@"
